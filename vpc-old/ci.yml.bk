---
.vpc:
  extends: .base-rules
  variables:
    RULES_CHANGES_PATH: "vpc/**/*"
    DIR_PATH: "vpc"

code-quality-vpc-terraform-lint:
  extends: [.vpc, .terraform_lint]

code-quality-vpc-terraform-fmt:
  extends: [.vpc, .terraform_fmt]

code-quality-vpc-yaml-lint:
  extends: [.vpc, .yaml_lint]

validate-syntax-vpc:
  extends: [.vpc, .validate_syntax]

validate-security-vpc:
  extends: [.vpc, .validate_security]

validate-security-checkov-vpc:
  extends: [.vpc, .validate_security_checkov]

build-vpc:
  rules:
    - if: $RULES_CHANGES_PATH != "vpc/**/*"
      when: never
    - !reference [.base-rules, rules]
  extends: [.vpc, .plan]
  needs: []

deploy-vpc:
  rules:
    - if: $RULES_CHANGES_PATH != "vpc/**/*"
      when: never
    - !reference [.base-rules, rules]
  extends: [.vpc, .apply]
  needs: ["build-vpc"]

destroy-vpc:
  rules:
    - if: $RULES_CHANGES_PATH != "vpc/**/*"
      when: never
    - !reference [.destroy, rules]
    - !reference [.base-rules, rules]
  extends: [.vpc, .destroy]
  needs: ["build-vpc"]
